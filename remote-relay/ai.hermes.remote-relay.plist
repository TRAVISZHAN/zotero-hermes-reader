<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hermes.remote-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/.hermes-openwebui-adapter/venv/bin/python</string>
    <string>/Users/YOUR_USERNAME/.hermes-remote-relay/hermes-remote-relay.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HERMES_HOME</key>
    <string>/Users/YOUR_USERNAME/.hermes</string>
    <key>HERMES_RELAY_HOST</key>
    <string>100.x.y.z</string>
    <key>HERMES_RELAY_PORT</key>
    <string>8644</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/.hermes-remote-relay</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/.hermes-remote-relay/relay.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/.hermes-remote-relay/relay.error.log</string>
</dict>
</plist>
